#!/usr/bin/env python3
"""Fake Work IQ (M365) CLI for the personal laptop: people, Teams, mail, calendar.

Flags and output shapes are guesses at the real workiq. Fixtures: tests/fakes/data/*.json.
"""

from __future__ import annotations

import argparse

from _fakelib import NOW, after, emit, load, matches, since_arg


def people_lookup(a: argparse.Namespace) -> None:
    rows = [p for p in load("people") if matches(a.name, p["display_name"], p["email"])]
    emit({"people": rows[: a.limit]})


def messages(kind: str, a: argparse.Namespace) -> None:
    start = since_arg(a.since)
    rows = [
        m
        for m in load(kind)
        if (not a.query or matches(a.query, m["text"], m.get("subject"), m.get("chat")))
        and (not a.sender or matches(a.sender, m["from"]))
        and after(m["sent_at"], start)
    ]
    rows.sort(key=lambda m: m["sent_at"], reverse=True)
    emit({"messages": rows[: a.limit]})


def calendar_today(_: argparse.Namespace) -> None:
    today = NOW.date().isoformat()
    emit({"events": [e for e in load("calendar") if e["start"].startswith(today)]})


def add_search(sub: argparse._SubParsersAction, kind: str) -> None:  # type: ignore[type-arg]
    s = sub.add_parser("search", help=f"search {kind}")
    s.add_argument("--query", default="")
    s.add_argument("--from", dest="sender")
    s.add_argument("--since", help="today, 24h, -3d or ISO timestamp")
    s.add_argument("--limit", type=int, default=20)
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=lambda a: messages(kind, a))


def parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="workiq", description="Work IQ CLI (fake)")
    area = p.add_subparsers(dest="area", required=True)

    people = area.add_parser("people", help="directory").add_subparsers(dest="verb", required=True)
    lk = people.add_parser("lookup", help="look up people by name or email")
    lk.add_argument("--name", required=True)
    lk.add_argument("--limit", type=int, default=5)
    lk.add_argument("--json", action="store_true")
    lk.set_defaults(fn=people_lookup)

    add_search(area.add_parser("teams", help="Teams chats").add_subparsers(dest="verb", required=True), "teams")
    add_search(area.add_parser("mail", help="Outlook mail").add_subparsers(dest="verb", required=True), "mail")

    cal = area.add_parser("calendar", help="calendar").add_subparsers(dest="verb", required=True)
    td = cal.add_parser("today", help="today's events")
    td.add_argument("--json", action="store_true")
    td.set_defaults(fn=calendar_today)
    return p


if __name__ == "__main__":
    args = parser().parse_args()
    args.fn(args)
