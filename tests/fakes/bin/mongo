#!/usr/bin/env python3
"""Fake MongoDB query CLI for the personal laptop: find and count documents by a JSON filter.

`$where` and other JavaScript operators are refused, as the design requires.
"""

from __future__ import annotations

import json
import sys

from _fakelib import emit, fail, flag, help_or, load_map

HELPS = {
    "": """mongo-cli queries MongoDB collections (fake).

Usage:
  mongo [command]

Available Commands:
  find         Find documents in a collection with a JSON filter
  count        Count documents matching a JSON filter
  collections  List collections
  insert       Insert a document
  drop         Drop a collection

Flags:
  -h, --help   help for mongo
""",
    "find": """Find documents in a collection with a JSON filter.

Usage:
  mongo find --collection NAME [--filter JSON] [--projection JSON] [--limit N] [--json]

Examples:
  mongo find --collection users --filter '{"email": "jane@example.com"}' --json
  mongo find --collection orders --filter '{"account_id": 42}' --limit 10 --json

Flags:
      --collection string   collection name
      --filter string       JSON filter with equality matches (default {})
      --projection string   JSON projection, e.g. {"email": 1}
      --limit int           max documents (default 20)
      --json                print JSON
""",
    "count": """Count documents matching a JSON filter.

Usage:
  mongo count --collection NAME [--filter JSON] [--json]
""",
    "collections": """List collections.

Usage:
  mongo collections [--json]
""",
}


def documents(argv: list[str]) -> list[dict]:
    db = load_map("mongo")
    name = flag(argv, "--collection")
    if name not in db:
        fail(f"error: no collection {name!r}; have {sorted(db)}")
    try:
        query = json.loads(flag(argv, "--filter", default="{}") or "{}")
    except json.JSONDecodeError as exc:
        fail(f"error: --filter is not JSON: {exc}")
        raise
    if any(str(k).startswith("$") for k in query):
        fail("error: operators like $where are refused; use equality filters")
    return [d for d in db[name] if all(d.get(k) == v for k, v in query.items())]


if __name__ == "__main__":
    argv = sys.argv[1:]
    words = help_or(HELPS, argv, frozenset({"--collection", "--filter", "--projection", "--limit"}))
    if words[:1] == ["find"]:
        docs = documents(argv)[: int(flag(argv, "--limit", default="20") or 20)]
        projection = json.loads(flag(argv, "--projection", default="{}") or "{}")
        if projection:
            docs = [{k: v for k, v in d.items() if k in projection or k == "_id"} for d in docs]
        emit({"documents": docs, "count": len(docs)})
    elif words[:1] == ["count"]:
        emit({"count": len(documents(argv))})
    elif words[:1] == ["collections"]:
        emit({"collections": [{"name": n, "count": len(v)} for n, v in sorted(load_map("mongo").items())]})
    elif words[:1] in (["insert"], ["drop"]):
        fail("error: this fake mongo never writes")
    else:
        fail(f"unknown command {words[:1]}")
